APP_ENV=dev
DEBUG=false

# MySQL 平台元数据主库 (支持 aiomysql；本地无 MySQL 测试可用 sqlite+aiosqlite)
MYSQL_DSN=mysql+aiomysql://root:123456@127.0.0.1:3306/auto_dev_db?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true

# ES & Qdrant 报错经验缓存与可选运行时日志
ES_URL=http://127.0.0.1:9200
ES_ENABLED=true
ES_ERROR_CACHE_INDEX=auto_dev_error_cache_bm25

QDRANT_URL=http://127.0.0.1:6333
QDRANT_ENABLED=true
QDRANT_ERROR_CACHE_COLLECTION=auto_dev_error_cache_vec
EMBEDDING_DIM=1024
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# 大模型配置 (Lazy 加载)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# 凭证加密密钥 (32 字节安全密文派生种子)
SECRET_KEY=auto-dev-agent-change-me-in-prod

# 沙箱与本地日志降级通用配置
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_MAX_RETRIES=3
SANDBOX_REQUIRE_DOCKER=true
LOG_SCAN_GLOBS=["*.log", "logs/*.log"]
